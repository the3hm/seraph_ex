<section class="content-header">
  <h1>
    New Weather
  </h1>

  <ol class="breadcrumb">
    <li><%= link("Home", to: dashboard_path(@conn, :index)) %></li>
    <li><%= link("Weather", to: weather_path(@conn, :index)) %></li>
    <li class="active">New</li>
  </ol>
</section>

<section class="content">
  <div class="row">
    <div class="col-md-12">
      <div class="box box-primary">
        <div class="box-header">
          <h3 class="box-title">New Weather</h3>
        </div>
        <%= render "_form.html", changeset: @changeset, action: weather_path(@conn, :create), conn: @conn %>
      </div>
    </div>
  </div>
</section>
