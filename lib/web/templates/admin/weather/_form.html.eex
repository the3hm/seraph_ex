<%= form_for @changeset, @action, [class: "form-horizontal"], fn f -> %>
  <%= if @changeset.action do %>
    <div class="alert alert-danger">
      There was an error creating the weather. Please check the errors below.
    </div>
  <% end %>

  <div class="box-body">
    <div class="form-group">
      <%= label f, :name, class: "col-sm-2 control-label" %>
      <div class="col-sm-10">
        <%= text_input f, :name, class: "form-control" %>
        <%= error_tag f, :name %>
      </div>
    </div>

    <div class="form-group">
      <%= label f, :description, class: "col-sm-2 control-label" %>
      <div class="col-sm-10">
        <%= text_input f, :description, class: "form-control" %>
        <%= error_tag f, :description %>
      </div>
    </div>

    <div class="form-group">
      <%= label f, :valid_ecologies, class: "col-sm-2 control-label" %>
      <div class="col-sm-10">
        <%= multiple_select f, :valid_ecologies, Data.Room.ecologies(), class: "form-control", selected: (f.data.valid_ecologies || []) %>
        <%= error_tag f, :valid_ecologies %>
      </div>
    </div>

    <div class="form-group">
      <%= label f, :ecology_descriptions, "Ecology-specific Descriptions", class: "col-sm-2 control-label" %>
      <div class="col-sm-10">
        <div class="box box-default">
          <div class="box-body">
            <%= Enum.map Data.Room.ecologies(), fn ecology -> %>
              <div class="form-group">
                <%= label :ecology_descriptions, ecology, class: "col-sm-2 control-label" %>
                <div class="col-sm-10">
                  <%= text_input f, :ecology_descriptions, name: "weather[ecology_descriptions][#{ecology}]", value: get_in(f.data.ecology_descriptions || %{}, [ecology]), class: "form-control" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <%= error_tag f, :ecology_descriptions %>
      </div>
    </div>
  </div>

  <div class="box-footer">
    <%= submit "Save", class: "btn btn-primary" %>
    <%= link "Cancel", to: weather_path(@conn, :index), class: "btn btn-default" %>
  </div>
<% end %>
